{
  "name": "lupe-backend",
  "version": "1.0.0",
  "description": "Backend de Lupe: agentes de búsqueda de convocatorias, integración con Telegram y modelo de datos para Asisco Up (Manizales).",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "elegibilidad:reevaluar": "tsx src/scripts/reevaluar-pendientes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@google/genai": "^2.31.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.2",
    "dotenv": "^18.0.7",
    "fastify": "^5.6.1",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  }
}
