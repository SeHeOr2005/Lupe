# Copia este archivo a .env y completa los valores. Nunca se commitea .env.

# --- Base de datos: Supabase (Postgres) ---
# Prisma se conecta por Postgres directo, no por la API de Supabase: sácala de
# Project Settings → Database → "Connection string" (no de Project API).
# Hay dos variantes, usa la que te sirva:
#   - "Session pooler" (puerto 5432, vía Supavisor): funciona igual que Postgres
#     normal (soporta prepared statements) y es compatible con redes solo IPv4
#     (la mayoría de hosting). RECOMENDADA para este backend (server persistente).
#   - "Direct connection" (puerto 5432, directo): solo si tu red tiene salida IPv6
#     (Supabase ya no da IPv4 gratis en la conexión directa).
# Evita el "Transaction pooler" (puerto 6543) salvo que agregues DIRECT_URL aparte
# para las migraciones (ver README § Conectar a Supabase) — rompe `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Servidor HTTP ---
NODE_ENV=development
PORT=3000
# Clave para usar la API: header `x-api-key: <clave>`. Obligatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
# IDs numéricos de Telegram autorizados a usar el bot, separados por coma (ej. "111,222").
# No hay tabla de usuarios en v2; esta lista es la autorización. Ver README.
TELEGRAM_ALLOWED_USER_IDS=

# --- IA: Google AI Studio / Gemini (gratis, sin tarjeta) ---
# Crea la clave en https://aistudio.google.com/apikey
IA_PROVIDER=gemini
GEMINI_API_KEY=
MODELO_EVALUADOR=gemini-2.5-flash-lite
MODELO_EXPLORADOR=gemini-2.5-flash
MAX_TOKENS_DIA=2000000

# --- IA: alternativas (plan B, no se usan salvo que cambies IA_PROVIDER) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# --- Supabase: API/SDK (reservadas, no se usan todavía) ---
# El backend solo necesita DATABASE_URL arriba. Estas quedan guardadas por si más
# adelante se conecta Supabase Storage (documentos) o Supabase Auth (panel web);
# hoy no las lee ningún archivo de src/.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- Worker / scheduler ---
# Cada cuántos ms el worker revisa qué fuentes tienen el cron vencido.
SCHEDULER_TICK_MS=60000

# --- General ---
TZ=America/Bogota
